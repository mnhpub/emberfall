{
  "name": "emberfall-survival",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:dev": "wrangler dev worker/index.ts",
    "cf:deploy": "wrangler deploy worker/index.ts",
    "db:migrate:local": "wrangler d1 migrations apply emberfall-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply emberfall-db --remote",
    "dev:web": "vite --host 0.0.0.0",
    "build:web": "tsc -b && vite build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:linux": "tauri build --bundles deb,rpm,appimage",
    "desktop:build:macos": "tauri build --bundles app,dmg",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:worker": "tsc -p tsconfig.worker.json",
    "check": "tsc -b && npm run check:worker",
    "asset:smoke": "python3 pipelines/dxf_pipeline.py fixtures/ship-panel.dxf --out build/assets/ship-panel",
    "test:browser": "node --experimental-strip-types scripts/browser-smoke.ts",
    "session:issue": "node --experimental-strip-types scripts/issue-session.ts",
    "test:authority": "node --experimental-strip-types scripts/authority-smoke.ts",
    "test:colonies": "node --experimental-strip-types scripts/colony-smoke.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "1.51.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.38.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
